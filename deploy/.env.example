# Salin jadi .env lalu isi:
JR_DOMAIN=ai.domainanda.com
# Bila SUDAH punya domain (HTTPS aktif, cookie Secure otomatis):
JR_PUBLIC_URL=https://ai.domainanda.com
# Bila BELUM punya domain: biarkan JR_PUBLIC_URL kosong (hapus/tandai komentar)
# dan akses via SSH tunnel: ssh -p PORT -L 20130:127.0.0.1:20130 user@server

JR_TZ=Asia/Jakarta
JR_LOG_PROMPTS=false
# Bila LlamaStash di host:
# JR_LLAMASTASH_URL=http://host.docker.internal:11435/v1
